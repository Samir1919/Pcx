# PCX environment configuration. Copy to `.env` and fill in local-only values.
# The `.env` file is git-ignored and must never be committed.
# `npm run dev` loads this file automatically before starting services.

# --- Local development (required for `npm run dev`) ---
NODE_ENV=development
API_PORT=4000
# The API's own address (used as the browser rewrite target / public origin).
PCX_API_ORIGIN=http://127.0.0.1:4000
# Comma-separated browser origins allowed to call the API (CORS/CSRF allow-list).
API_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# One-time code for the local dev MFA adapter (privileged demo admin login).
PCX_DEV_MFA_CODE=123456
# Points at the dev postgres container published in infra/docker-compose.yml.
DATABASE_URL=postgresql://pcx:pcx_local_only@localhost:5432/pcx
TEST_DATABASE_URL=postgresql://pcx:pcx_local_only@localhost:5432/pcx
REDIS_URL=redis://localhost:6379
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=pcx-local
OBJECT_STORAGE_ACCESS_KEY=pcx_local
OBJECT_STORAGE_SECRET_KEY=change_me_local_only

# --- Optional: multi-agent AI providers (opt-in) ---
# The autonomous loop can run an EXECUTOR and a REVIEWER against any of these
# providers. Select with `--executor-provider <name>` / `--reviewer-provider
# <name>` (deepseek | openai | anthropic | kimi), or keep the legacy flags
# `--deepseek-executor` / `--openai-review`.
#
# Every provider reads the same `<PREFIX>_*` variables:
#   <PREFIX>_API_KEY          required when that provider is used
#   <PREFIX>_MODEL            optional (defaults shown below)
#   <PREFIX>_ENDPOINT         optional (defaults shown below)
#   <PREFIX>_ENABLED          optional "true"|"false" (default enabled).
#                             Set "false" to HOLD a provider (keep its config
#                             but fail fast if selected).
#   <PREFIX>_THINKING         optional "enabled" — only for providers with a
#                             thinking block (deepseek, anthropic).
#   <PREFIX>_REASONING_EFFORT effort level; allowed values are provider-specific:
#                             deepseek  low|medium|high (maps to reasoning_effort)
#                             openai    low|medium|high (maps to reasoning_effort)
#                             anthropic low|medium|high|xhigh|max (maps to effort)
#                             kimi      low|high (maps to reasoning_effort)
#   <PREFIX>_MAX_TOKENS      optional max output tokens (default 4096; 8192 when
#                             thinking is on). Caps runaway generation — it does
#                             NOT stop a repeated tool-call loop.

# DeepSeek (deepseek | deepseek-v4-pro, reasoning-aware)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_ENDPOINT=https://api.deepseek.com/chat/completions
# DEEPSEEK_ENABLED=true
# DEEPSEEK_THINKING=enabled
# DEEPSEEK_REASONING_EFFORT=high

# OpenAI (executor or reviewer; reasoning_effort, no thinking block)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o
OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions
# OPENAI_ENABLED=true
# OPENAI_REASONING_EFFORT=medium

# Anthropic (Claude Messages API; thinking + `effort`)
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_ENDPOINT=https://api.anthropic.com/v1/messages
# ANTHROPIC_ENABLED=true
# ANTHROPIC_THINKING=enabled
# ANTHROPIC_REASONING_EFFORT=high

# Kimi K2 / Moonshot (OpenAI-compatible; reasoning_effort, no thinking block)
KIMI_API_KEY=sk-your-kimi-key-here
KIMI_MODEL=kimi-k2-0711-preview
KIMI_ENDPOINT=https://api.moonshot.cn/v1/chat/completions
# KIMI_ENABLED=true
# KIMI_REASONING_EFFORT=high
