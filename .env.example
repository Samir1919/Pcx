# PCX environment configuration (copy to .env and fill in real values).
# The .env file is git-ignored and must never be committed.

# DeepSeek executor (used with `--deepseek-executor`)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_MODEL=deepseek-chat

# OpenAI reviewer (used with `--openai-review`)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o
