# Production-compose environment example. Copy to `infra/.env` and fill in real
# values. Any file named `.env` here is git-ignored and must never be committed.
# All values below are local-only placeholders, NOT production secrets. On a
# real production host, inject real secrets from a secret manager/environment
# instead of `.env`.

# PostgreSQL connection string used by api, migrate, and worker. Must match
# POSTGRES_PASSWORD below when using the bundled postgres service.
DATABASE_URL=postgresql://pcx:pcx_prod_local_only@postgres:5432/pcx
POSTGRES_PASSWORD=pcx_prod_local_only

# MinIO root credentials for the bundled minio service.
MINIO_ROOT_PASSWORD=change_me_prod_local_only

# Comma-separated browser origins the API allows (CORS/authorization).
API_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081

# Server-side API destination baked into the Next.js rewrites at build time.
WEB_API_ORIGIN=http://api:4000
ADMIN_API_ORIGIN=http://api:4000
