# Staging environment template. Values are synthetic placeholders, never real
# secrets. Copy to a git-ignored file (for example infra/staging.env) and fill
# from a secret manager/environment before running the staging stack.
NODE_ENV=staging
API_PORT=4001
PCX_API_ORIGIN=http://127.0.0.1:4001
DATABASE_URL=postgresql://pcx_staging:pcx_staging_local_only@localhost:5433/pcx_staging
TEST_DATABASE_URL=postgresql://pcx_staging:pcx_staging_local_only@localhost:5433/pcx_staging
REDIS_URL=redis://localhost:6380
OBJECT_STORAGE_ENDPOINT=http://localhost:9002
OBJECT_STORAGE_BUCKET=pcx-staging
OBJECT_STORAGE_ACCESS_KEY=pcx_staging
OBJECT_STORAGE_SECRET_KEY=change_me_staging_local_only
