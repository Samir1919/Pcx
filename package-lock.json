{
  "name": "pcx-platform",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "pcx-platform",
      "version": "0.1.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=22 <23"
      }
    },
    "apps/admin": {
      "name": "@pcx/admin",
      "version": "0.1.0"
    },
    "apps/api": {
      "name": "@pcx/api",
      "version": "0.1.0"
    },
    "apps/web": {
      "name": "@pcx/web",
      "version": "0.1.0"
    },
    "apps/worker": {
      "name": "@pcx/worker",
      "version": "0.1.0"
    },
    "node_modules/@pcx/admin": {
      "resolved": "apps/admin",
      "link": true
    },
    "node_modules/@pcx/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@pcx/config": {
      "resolved": "packages/config",
      "link": true
    },
    "node_modules/@pcx/domain": {
      "resolved": "packages/domain",
      "link": true
    },
    "node_modules/@pcx/testing": {
      "resolved": "packages/testing",
      "link": true
    },
    "node_modules/@pcx/ui": {
      "resolved": "packages/ui",
      "link": true
    },
    "node_modules/@pcx/web": {
      "resolved": "apps/web",
      "link": true
    },
    "node_modules/@pcx/worker": {
      "resolved": "apps/worker",
      "link": true
    },
    "packages/config": {
      "name": "@pcx/config",
      "version": "0.1.0"
    },
    "packages/domain": {
      "name": "@pcx/domain",
      "version": "0.1.0"
    },
    "packages/testing": {
      "name": "@pcx/testing",
      "version": "0.1.0"
    },
    "packages/ui": {
      "name": "@pcx/ui",
      "version": "0.1.0"
    }
  }
}
