{
  "name": "pcx-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "node apps/api/src/index.mjs",
    "dev:worker": "node apps/worker/src/worker.mjs",
    "verify:e0": "node scripts/e0-check.mjs",
    "test": "node --test",
    "test:integration": "node --test apps/api/test/integration/*.test.mjs",
    "db:migrate": "node apps/api/src/infrastructure/database/migrate.mjs",
    "lint": "node scripts/lint-check.mjs",
    "typecheck": "node scripts/typecheck-check.mjs",
    "build": "node scripts/build-check.mjs",
    "security": "node scripts/security-check.mjs",
    "container:scan": "node scripts/container-scan.mjs",
    "smoke": "node scripts/smoke.mjs",
    "db:backup": "sh scripts/db-backup.sh",
    "db:restore-drill": "sh scripts/db-restore-drill.sh",
    "release:preflight": "node scripts/release-preflight.mjs",
    "autonomous:loop": "node scripts/autonomous-loop.mjs --dry-run",
    "verify": "npm run verify:e0 && npm run lint && npm run typecheck && npm test && npm run build && npm run security",
    "verify:ci": "npm run verify && npm run test:integration && npm run smoke"
  }
}
