{
  "name": "pcx-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node apps/api/src/index.mjs",
    "dev:web": "npm run dev -w @pcx/web -- -p 3000",
    "dev:admin": "npm run dev -w @pcx/admin -- -p 3001",
    "dev:worker": "node apps/worker/src/main.mjs",
    "dev:down": "node scripts/dev-down.mjs",
    "prod:build": "node scripts/prod.mjs build",
    "prod:up": "node scripts/prod.mjs up",
    "prod:down": "node scripts/prod.mjs down",
    "deploy": "node scripts/prod.mjs deploy",
    "verify:e0": "node scripts/e0-check.mjs",
    "test": "node --test",
    "test:integration": "node --test apps/api/test/integration/*.test.mjs",
    "db:migrate": "node apps/api/src/infrastructure/database/migrate.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "lint": "node scripts/lint-check.mjs",
    "typecheck": "node scripts/typecheck-check.mjs",
    "build": "node scripts/build-check.mjs",
    "security": "node scripts/security-check.mjs",
    "container:scan": "node scripts/container-scan.mjs",
    "smoke": "node scripts/smoke.mjs",
    "db:backup": "sh scripts/db-backup.sh",
    "db:restore-drill": "sh scripts/db-restore-drill.sh",
    "release:preflight": "node scripts/release-preflight.mjs",
    "autonomous:loop": "node scripts/autonomous-loop.mjs --dry-run",
    "web:check": "node scripts/web-check.mjs",
    "web:e2e": "node scripts/storefront-e2e-check.mjs",
    "staging:smoke": "node scripts/staging-smoke.mjs",
    "admin:e2e": "node scripts/admin-e2e-check.mjs",
    "merge-gate": "node scripts/merge-gate.mjs",
    "merge-check": "node scripts/merge-gate.mjs",
    "ui-guard": "node scripts/browser-verify-guard.mjs",
    "verify": "npm run verify:e0 && npm run lint && npm run typecheck && npm test && npm run build && npm run security && npm run ui-guard",
    "verify:ci": "npm run verify && npm run test:integration && npm run smoke"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
