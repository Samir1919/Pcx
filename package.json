{
  "name": "pcx-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22 <23" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:api": "node apps/api/src/server.mjs",
    "dev:worker": "node apps/worker/src/worker.mjs",
    "verify:e0": "node scripts/e0-check.mjs",
    "test": "node --test",
    "lint": "node scripts/lint-check.mjs",
    "typecheck": "node scripts/typecheck-check.mjs",
    "build": "node scripts/build-check.mjs",
    "verify": "npm run verify:e0 && npm run lint && npm run typecheck && npm test && npm run build"
  }
}
